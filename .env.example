MONGO_DB_URL=
SESSION_SECRET=

# KeyCafe API (https://docs.keycafe.com)
# Generate this from your KeyCafe account: user menu (top right) > My
# Account > Advanced > API Settings > Generate Key.
# That dashboard screen issues an "API Key" even though KeyCafe's docs call
# that scheme deprecated in favor of "API Tokens" — either works here, you
# just have to tell the app which one you have via KEYCAFE_AUTH_TYPE below,
# or it'll send the wrong Basic Auth username and get a 401.
KEYCAFE_EMAIL=
KEYCAFE_TOKEN=
# "token" (default, matches KeyCafe's recommended scheme) or "key" (what the
# dashboard's "Generate Key" button actually issues, as of writing).
KEYCAFE_AUTH_TYPE=token
KEYCAFE_TIMEZONE=America/Phoenix

# If KEYCAFE_EMAIL and KEYCAFE_TOKEN are not set, the app uses mock access codes for development.

# KeyCafe webhook (key pickup/dropoff notifications)
# Pick your own username/password here, then register this app's webhook URL
# (https://<your-domain>/webhooks/keycafe) with these same credentials in
# KeyCafe: More > Advanced > API Settings > Webhook (or via the Create Webhook API).
# KeyCafe sends these credentials back as HTTP Basic Auth on every webhook call.
KEYCAFE_WEBHOOK_USERNAME=
KEYCAFE_WEBHOOK_PASSWORD=

# Public URL of this app, used to build links inside emails (no trailing slash).
APP_BASE_URL=http://localhost:8080

# Outgoing email (booking confirmation + reminder notifications).
# Works with any SMTP provider/mailbox. If these are not set, emails are
# logged to the console instead of actually sent (safe for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Monthly vehicle mileage log email — sent automatically for every vehicle
# on the last business day of each month. Defaults shown below.
MILEAGE_LOG_RECIPIENT=Transportation@communityfoodbank.org
MILEAGE_LOG_TIMEZONE=America/Phoenix
