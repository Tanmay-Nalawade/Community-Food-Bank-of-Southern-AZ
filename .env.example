MONGO_DB_URL=
SESSION_SECRET=

# KeyCafe API (https://docs.keycafe.com)
# Use an API token from your KeyCafe account settings.
# Auth format: {email}/token with the token as the password.
KEYCAFE_EMAIL=
KEYCAFE_TOKEN=
KEYCAFE_TIMEZONE=America/Phoenix

# If KEYCAFE_EMAIL and KEYCAFE_TOKEN are not set, the app uses mock access codes for development.

# KeyCafe webhook (key pickup/dropoff notifications)
# Pick your own username/password here, then register this app's webhook URL
# (https://<your-domain>/webhooks/keycafe) with these same credentials in
# KeyCafe: More > Advanced > API Settings > Webhook (or via the Create Webhook API).
# KeyCafe sends these credentials back as HTTP Basic Auth on every webhook call.
KEYCAFE_WEBHOOK_USERNAME=
KEYCAFE_WEBHOOK_PASSWORD=
