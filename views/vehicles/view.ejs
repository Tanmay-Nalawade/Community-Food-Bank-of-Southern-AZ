<% layout('layouts/boilerplate') %>

<section class="vehicle-detail">
  <a class="vehicle-detail__back" href="<%= backHref %>">&larr; <%= backLabel %></a>

  <% if (bookingLabel) { %>
    <p class="vehicle-detail__booking-window">
      Selected time: <strong><%= bookingLabel %></strong>
    </p>
  <% } %>

  <div class="vehicle-detail__layout">
    <div class="vehicle-detail__main">
      <div class="vehicle-detail__overview">
        <% if (vehicle.photoUrl) { %>
          <img class="vehicle-detail__photo" src="<%= vehicle.photoUrl %>" alt="Photo of <%= vehicle.make %> <%= vehicle.model %>" />
        <% } else { %>
          <div class="vehicle-detail__photo vehicle-detail__photo--empty">No photo yet</div>
        <% } %>

        <div class="vehicle-detail__overview-body">
          <header class="vehicle-detail__header">
            <div>
              <h1>
                <%= vehicle.year ? vehicle.year + " " : "" %><%= vehicle.make %> <%= vehicle.model %>
              </h1>
              <p class="vehicle-detail__plate"><%= vehicle.licensePlate %></p>
            </div>
            <%- include('../partials/status-pill', { prefix: 'vehicle-card__status', value: vehicle.status }) %>
          </header>

          <dl class="vehicle-detail__card">
            <div>
              <dt>Make</dt>
              <dd><%= vehicle.make %></dd>
            </div>
            <div>
              <dt>Model</dt>
              <dd><%= vehicle.model %></dd>
            </div>
            <div>
              <dt>Year</dt>
              <dd><%= vehicle.year || "—" %></dd>
            </div>
            <div>
              <dt>License plate</dt>
              <dd><%= vehicle.licensePlate %></dd>
            </div>
            <div>
              <dt>Current mileage</dt>
              <dd><%= vehicle.currentMileage.toLocaleString() %> mi</dd>
            </div>
            <div>
              <dt>KeyCafe key ID</dt>
              <dd><%= vehicle.keyCafeKeyId %></dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="vehicle-detail__card">
        <h2 class="vehicle-detail__section-title">Active issues</h2>
        <% if (!vehicle.activeIssues.length) { %>
          <p class="vehicle-detail__empty">No reported issues.</p>
        <% } else { %>
          <ul class="vehicle-detail__issues">
            <% vehicle.activeIssues.forEach((issue) => { %>
              <li>
                <span class="vehicle-detail__issue-date">
                  <%= new Date(issue.reportedAt).toLocaleDateString() %>
                </span>
                <%= issue.description %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>

    <aside class="vehicle-detail__sidebar">
      <div class="vehicle-detail__card booking-request-card">
        <h2 class="vehicle-detail__section-title">Book this vehicle</h2>

        <% if (effectiveRole === "Admin") { %>
          <p class="vehicle-detail__empty">
            Admins manage reservations from the
            <a href="/admin/reservations">admin dashboard</a>.
          </p>
        <% } else if (effectiveRole === "IT Admin") { %>
          <p class="vehicle-detail__empty">
            IT Admins manage system access and configuration from the
            <a href="/it/users">IT dashboard</a>. Switch to Staff view from the account menu to book a vehicle.
          </p>
        <% } else if (booking) { %>
          <form class="auth-form" action="/reservations/vehicles/<%= vehicle._id %>" method="POST">
            <input type="hidden" name="date" value="<%= booking.date %>" />
            <input type="hidden" name="startTime" value="<%= booking.startTime %>" />
            <input type="hidden" name="endTime" value="<%= booking.endTime %>" />

            <div class="auth-form__group">
              <label class="auth-form__label" for="staffNotes">Notes for Transportation (optional)</label>
              <textarea
                class="auth-form__input booking-request-card__textarea"
                id="staffNotes"
                name="staffNotes"
                rows="3"
                placeholder="Purpose of trip, passengers, etc."
              ></textarea>
            </div>

            <button class="auth-form__submit" type="submit">Book this vehicle</button>
          </form>
        <% } else if (vehicle.status === "Available") { %>
          <p class="vehicle-detail__lead-in">Choose a date and time to reserve this vehicle.</p>
          <form class="auth-form" action="/reservations/vehicles/<%= vehicle._id %>" method="POST">
            <div class="auth-form__group">
              <label class="auth-form__label" for="date">Date</label>
              <input
                class="auth-form__input"
                type="date"
                id="date"
                name="date"
                min="<%= minDate %>"
                required
              />
            </div>

            <div class="auth-form__row">
              <div class="auth-form__group">
                <label class="auth-form__label" for="startTime">Start time</label>
                <input
                  class="auth-form__input"
                  type="time"
                  id="startTime"
                  name="startTime"
                  value="08:00"
                  required
                />
              </div>
              <div class="auth-form__group">
                <label class="auth-form__label" for="endTime">End time</label>
                <input
                  class="auth-form__input"
                  type="time"
                  id="endTime"
                  name="endTime"
                  value="17:00"
                  required
                />
              </div>
            </div>

            <div class="auth-form__group">
              <label class="auth-form__label" for="staffNotes">Notes for Transportation (optional)</label>
              <textarea
                class="auth-form__input booking-request-card__textarea"
                id="staffNotes"
                name="staffNotes"
                rows="3"
                placeholder="Purpose of trip, passengers, etc."
              ></textarea>
            </div>

            <button class="auth-form__submit" type="submit">Book this vehicle</button>
          </form>
        <% } else { %>
          <p class="vehicle-detail__empty">This vehicle isn&rsquo;t currently available to book.</p>
        <% } %>
      </div>
    </aside>
  </div>
</section>
