<% layout('layouts/boilerplate') %>

<section class="vehicle-detail">
  <a class="vehicle-detail__back" href="/vehicles<%= queryString ? '?' + queryString : '' %>">&larr; Back to available vehicles</a>

  <% if (bookingLabel) { %>
    <p class="vehicle-detail__booking-window">
      Selected time: <strong><%= bookingLabel %></strong>
    </p>
  <% } %>

  <header class="vehicle-detail__header">
    <div>
      <h1>
        <%= vehicle.year ? vehicle.year + " " : "" %><%= vehicle.make %> <%= vehicle.model %>
      </h1>
      <p class="vehicle-detail__plate"><%= vehicle.licensePlate %></p>
    </div>
    <span class="vehicle-card__status vehicle-card__status--<%= vehicle.status.toLowerCase().replace(/\s+/g, '-') %>">
      <%= vehicle.status %>
    </span>
  </header>

  <div class="vehicle-detail__grid">
    <dl class="vehicle-detail__card">
      <div>
        <dt>Make</dt>
        <dd><%= vehicle.make %></dd>
      </div>
      <div>
        <dt>Model</dt>
        <dd><%= vehicle.model %></dd>
      </div>
      <div>
        <dt>Year</dt>
        <dd><%= vehicle.year || "—" %></dd>
      </div>
      <div>
        <dt>License plate</dt>
        <dd><%= vehicle.licensePlate %></dd>
      </div>
      <div>
        <dt>Current mileage</dt>
        <dd><%= vehicle.currentMileage.toLocaleString() %> mi</dd>
      </div>
      <div>
        <dt>KeyCafe key ID</dt>
        <dd><%= vehicle.keyCafeKeyId %></dd>
      </div>
    </dl>

    <div class="vehicle-detail__card">
      <h2 class="vehicle-detail__section-title">Active issues</h2>
      <% if (!vehicle.activeIssues.length) { %>
        <p class="vehicle-detail__empty">No reported issues.</p>
      <% } else { %>
        <ul class="vehicle-detail__issues">
          <% vehicle.activeIssues.forEach((issue) => { %>
            <li>
              <span class="vehicle-detail__issue-date">
                <%= new Date(issue.reportedAt).toLocaleDateString() %>
              </span>
              <%= issue.description %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>

  <% if (booking) { %>
    <div class="vehicle-detail__card booking-request-card">
      <h2 class="vehicle-detail__section-title">Book this vehicle</h2>

      <% if (!currentUser) { %>
        <p class="vehicle-detail__empty">
          Please <a href="/login">log in</a> as a staff member to book this vehicle.
        </p>
      <% } else if (currentUser.role === "Admin") { %>
        <p class="vehicle-detail__empty">
          Admins manage reservations from the
          <a href="/admin/reservations">admin dashboard</a>.
        </p>
      <% } else { %>
        <form class="auth-form" action="/reservations/vehicles/<%= vehicle._id %>" method="POST">
          <input type="hidden" name="date" value="<%= booking.date %>" />
          <input type="hidden" name="startTime" value="<%= booking.startTime %>" />
          <input type="hidden" name="endTime" value="<%= booking.endTime %>" />

          <div class="auth-form__group">
            <label class="auth-form__label" for="staffNotes">Notes for Transportation (optional)</label>
            <textarea
              class="auth-form__input booking-request-card__textarea"
              id="staffNotes"
              name="staffNotes"
              rows="3"
              placeholder="Purpose of trip, passengers, etc."
            ></textarea>
          </div>

          <button class="auth-form__submit" type="submit">Book this vehicle</button>
        </form>
      <% } %>
    </div>
  <% } %>
</section>
