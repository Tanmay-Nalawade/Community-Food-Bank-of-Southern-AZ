<% layout('layouts/boilerplate') %>

<section class="vehicles-page">
  <div class="vehicles-page__header">
    <div>
      <h1>All Vehicles</h1>
      <p class="vehicles-page__lead">
        The full fleet roster, regardless of availability for any particular time.
      </p>
    </div>
    <% if (currentUser && effectiveRole === "Admin") { %>
      <a class="vehicles-page__add-btn" href="/admin/vehicles/add">Add Vehicle</a>
    <% } %>
  </div>

  <form class="admin-filters" method="GET" action="/vehicles/all">
    <div class="admin-filters__field">
      <label class="auth-form__label" for="q">Search</label>
      <input
        class="auth-form__input"
        type="text"
        id="q"
        name="q"
        placeholder="Make, model, or plate"
        value="<%= q %>"
      />
    </div>

    <button class="admin-filters__submit" type="submit">Search</button>
    <% if (q) { %>
      <a class="admin-filters__clear" href="/vehicles/all">Clear</a>
    <% } %>
  </form>

  <% if (!vehicles.length) { %>
    <p class="vehicles-page__empty">No vehicles match your search.</p>
  <% } else { %>
    <div class="vehicle-grid">
      <% vehicles.forEach((vehicle) => { %>
        <%- include('../partials/vehicle-card', {
          vehicle,
          href: `/vehicles/${vehicle._id}?from=all${q ? '&q=' + encodeURIComponent(q) : ''}`,
        }) %>
      <% }) %>
    </div>
  <% } %>
</section>
