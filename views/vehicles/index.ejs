<% layout('layouts/boilerplate') %>

<section class="vehicles-page">
  <div class="vehicles-page__header">
    <div>
      <h1>Available Vehicles</h1>
      <p class="vehicles-page__lead">
        Showing vehicles available for <strong><%= bookingLabel %></strong>.
      </p>
      <a class="vehicles-page__change-date" href="/">Change date or time</a>
    </div>
    <% if (currentUser && currentUser.role === "Admin") { %>
      <a class="vehicles-page__add-btn" href="/admin/vehicles/add">Add Vehicle</a>
    <% } %>
  </div>

  <form class="admin-filters" method="GET" action="/vehicles">
    <input type="hidden" name="date" value="<%= booking.date %>" />
    <input type="hidden" name="startTime" value="<%= booking.startTime %>" />
    <input type="hidden" name="endTime" value="<%= booking.endTime %>" />

    <div class="admin-filters__field">
      <label class="auth-form__label" for="q">Search</label>
      <input
        class="auth-form__input"
        type="text"
        id="q"
        name="q"
        placeholder="Make, model, or plate"
        value="<%= q %>"
      />
    </div>

    <button class="admin-filters__submit" type="submit">Search</button>
    <% if (q) { %>
      <a class="admin-filters__clear" href="/vehicles?<%= baseQueryString %>">Clear</a>
    <% } %>
  </form>

  <% if (!vehicles.length) { %>
    <p class="vehicles-page__empty">No vehicles match your search for this time slot.</p>
  <% } else { %>
    <div class="vehicle-grid">
      <% vehicles.forEach((vehicle) => { %>
        <a class="vehicle-card vehicle-card--link" href="/vehicles/<%= vehicle._id %>?<%= queryString %>">
          <header class="vehicle-card__header">
            <h2 class="vehicle-card__title">
              <%= vehicle.year ? vehicle.year + " " : "" %><%= vehicle.make %> <%= vehicle.model %>
            </h2>
            <span class="vehicle-card__status vehicle-card__status--available">
              Available
            </span>
          </header>
          <dl class="vehicle-card__details">
            <div>
              <dt>License plate</dt>
              <dd><%= vehicle.licensePlate %></dd>
            </div>
            <div>
              <dt>Mileage</dt>
              <dd><%= vehicle.currentMileage.toLocaleString() %> mi</dd>
            </div>
          </dl>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
