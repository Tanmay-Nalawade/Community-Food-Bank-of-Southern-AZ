<% layout('layouts/boilerplate') %>

<section class="auth-page">
  <div class="auth-card auth-card--wide">
    <h1 class="auth-card__title">Add Vehicle</h1>
    <p class="auth-card__subtitle">Register a new motor pool vehicle.</p>

    <form class="auth-form" action="/admin/vehicles/add" method="POST">
      <div class="auth-form__row">
        <div class="auth-form__group">
          <label class="auth-form__label" for="make">Make</label>
          <input
            class="auth-form__input"
            type="text"
            id="make"
            name="make"
            placeholder="Ford"
            required
          />
        </div>
        <div class="auth-form__group">
          <label class="auth-form__label" for="model">Model</label>
          <input
            class="auth-form__input"
            type="text"
            id="model"
            name="model"
            placeholder="Transit"
            required
          />
        </div>
      </div>

      <div class="auth-form__row">
        <div class="auth-form__group">
          <label class="auth-form__label" for="year">Year</label>
          <input
            class="auth-form__input"
            type="number"
            id="year"
            name="year"
            min="1900"
            max="2100"
            placeholder="2022"
          />
        </div>
        <div class="auth-form__group">
          <label class="auth-form__label" for="licensePlate">License plate</label>
          <input
            class="auth-form__input"
            type="text"
            id="licensePlate"
            name="licensePlate"
            placeholder="ABC-1234"
            required
          />
        </div>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label" for="keyCafeKeyId">KeyCafe key ID</label>
        <input
          class="auth-form__input"
          type="text"
          id="keyCafeKeyId"
          name="keyCafeKeyId"
          required
        />
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label" for="currentMileage">Current mileage</label>
        <input
          class="auth-form__input"
          type="number"
          id="currentMileage"
          name="currentMileage"
          min="0"
          value="0"
          required
        />
      </div>

      <button class="auth-form__submit" type="submit">Add Vehicle</button>
    </form>

    <p class="auth-card__footer">
      <a href="/vehicles">Back to all vehicles</a>
    </p>
  </div>
</section>
