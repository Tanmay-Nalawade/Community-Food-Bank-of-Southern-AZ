<% layout('layouts/boilerplate') %>

<section class="auth-page">
  <div class="auth-card auth-card--wide">
    <h1 class="auth-card__title">My Account</h1>
    <p class="auth-card__subtitle">Update your name, email, or password.</p>

    <form class="auth-form" action="/account/edit" method="POST" novalidate>
      <div class="auth-form__row">
        <div class="auth-form__group">
          <label class="auth-form__label" for="firstName">First name</label>
          <input
            class="auth-form__input"
            type="text"
            id="firstName"
            name="firstName"
            value="<%= currentUser.firstName %>"
            autocomplete="given-name"
            aria-describedby="firstName-error"
            required
          />
          <p class="auth-form__field-error" id="firstName-error" aria-live="polite"></p>
        </div>
        <div class="auth-form__group">
          <label class="auth-form__label" for="lastName">Last name</label>
          <input
            class="auth-form__input"
            type="text"
            id="lastName"
            name="lastName"
            value="<%= currentUser.lastName %>"
            autocomplete="family-name"
            aria-describedby="lastName-error"
            required
          />
          <p class="auth-form__field-error" id="lastName-error" aria-live="polite"></p>
        </div>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label" for="email">Email</label>
        <input
          class="auth-form__input"
          type="email"
          id="email"
          name="email"
          value="<%= currentUser.email %>"
          autocomplete="email"
          aria-describedby="email-error"
          required
        />
        <p class="auth-form__field-error" id="email-error" aria-live="polite"></p>
      </div>

      <button class="auth-form__submit" type="submit">Save Changes</button>
    </form>

    <form class="auth-form auth-form--section" action="/account/change-password" method="POST" novalidate>
      <h2 class="auth-card__section-title">Change Password</h2>

      <div class="auth-form__group">
        <div class="auth-form__label-row">
          <label class="auth-form__label" for="currentPassword">Current password</label>
          <button type="button" class="auth-form__toggle-password" data-target="currentPassword">Show</button>
        </div>
        <input
          class="auth-form__input"
          type="password"
          id="currentPassword"
          name="currentPassword"
          autocomplete="current-password"
          aria-describedby="currentPassword-error"
          required
        />
        <p class="auth-form__field-error" id="currentPassword-error" aria-live="polite"></p>
      </div>

      <div class="auth-form__group">
        <div class="auth-form__label-row">
          <label class="auth-form__label" for="newPassword">New password</label>
          <button type="button" class="auth-form__toggle-password" data-target="newPassword">Show</button>
        </div>
        <input
          class="auth-form__input"
          type="password"
          id="newPassword"
          name="newPassword"
          autocomplete="new-password"
          aria-describedby="newPassword-error"
          required
        />
        <p class="auth-form__field-error" id="newPassword-error" aria-live="polite"></p>
      </div>

      <div class="auth-form__group">
        <div class="auth-form__label-row">
          <label class="auth-form__label" for="confirmNewPassword">Confirm new password</label>
          <button type="button" class="auth-form__toggle-password" data-target="confirmNewPassword">Show</button>
        </div>
        <input
          class="auth-form__input"
          type="password"
          id="confirmNewPassword"
          name="confirmNewPassword"
          autocomplete="new-password"
          aria-describedby="confirmNewPassword-error"
          required
        />
        <p class="auth-form__field-error" id="confirmNewPassword-error" aria-live="polite"></p>
      </div>

      <button class="auth-form__submit" type="submit">Change Password</button>
    </form>
  </div>
</section>
