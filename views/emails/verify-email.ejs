<!DOCTYPE html>
<html>
  <body style="margin:0; padding:0; background:#fbf7f9; font-family: Helvetica, Arial, sans-serif;">
    <div style="max-width:480px; margin:0 auto; padding:32px 24px;">
      <h1 style="color:#632c4f; font-size:20px; margin:0 0 16px;">Community Food Bank Motor Pool</h1>
      <p style="color:#333; font-size:15px; line-height:1.5; margin:0 0 12px;">Hi <%= firstName %>,</p>

      <p style="color:#333; font-size:15px; line-height:1.5; margin:0 0 12px;">
        Thanks for creating an account. Confirm it's really you by clicking below — this finishes setting up your account so you can log in.
      </p>

      <p style="margin:24px 0;">
        <a href="<%= link %>" style="background:#632c4f; color:#fff; font-weight:bold; text-decoration:none; padding:12px 20px; border-radius:6px; display:inline-block;">Verify Email</a>
      </p>

      <p style="color:#666; font-size:13px; line-height:1.5; margin:0 0 12px;">
        This link expires in 24 hours. If you didn't create this account, you can ignore this email.
      </p>

      <p style="color:#999; font-size:12px; margin-top:24px;">Community Food Bank of Southern Arizona</p>
    </div>
  </body>
</html>
