<!DOCTYPE html>
<html>
  <body style="margin:0; padding:0; background:#fbf7f9; font-family: Helvetica, Arial, sans-serif;">
    <div style="max-width:480px; margin:0 auto; padding:32px 24px;">
      <h1 style="color:#632c4f; font-size:20px; margin:0 0 16px;">Community Food Bank Motor Pool</h1>
      <p style="color:#333; font-size:15px; line-height:1.5; margin:0 0 12px;">Hi <%= firstName %>,</p>

      <p style="color:#333; font-size:15px; line-height:1.5; margin:0 0 12px;">
        <% if (isFinal) { %>
          Reminder — your vehicle pickup is coming up soon.
        <% } else { %>
          Just a heads up — your vehicle booking is coming up in a few days.
        <% } %>
      </p>

      <table style="width:100%; background:#fff; border:1px solid #e0e0e0; border-radius:8px; margin:16px 0;" cellpadding="10" cellspacing="0">
        <tr>
          <td style="color:#666; font-size:13px; width:90px;">Vehicle</td>
          <td style="color:#333; font-size:14px; font-weight:bold;"><%= vehicleName %></td>
        </tr>
        <tr>
          <td style="color:#666; font-size:13px;">When</td>
          <td style="color:#333; font-size:14px;"><%= bookingLabel %></td>
        </tr>
        <% if (bookingCode) { %>
          <tr>
            <td style="color:#666; font-size:13px;">Pickup code</td>
            <td style="color:#333; font-size:14px; font-family: ui-monospace, monospace;"><%= bookingCode %></td>
          </tr>
        <% } %>
      </table>

      <p style="font-size:14px; margin:0 0 24px;">
        <a href="<%= dashboardUrl %>" style="color:#632c4f; font-weight:bold; text-decoration:none;">View your bookings &rarr;</a>
      </p>

      <p style="color:#999; font-size:12px; margin-top:24px;">Community Food Bank of Southern Arizona</p>
    </div>
  </body>
</html>
