<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'Motor Pool' %> | Community Food Bank of Southern Arizona</title>
    <link rel="stylesheet" href="<%= asset('/css/navbar.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/app.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/auth.css') %>" />
    <% if (typeof isAdminSection !== 'undefined' && isAdminSection) { %>
      <link rel="stylesheet" href="<%= asset('/css/admin.css') %>" />
    <% } else { %>
      <link rel="stylesheet" href="<%= asset('/css/staff.css') %>" />
    <% } %>
  </head>
  <body class="site-shell">
    <%- include('../partials/navbar') %>
    <main class="page-content">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
    <%- include('../partials/footer') %>
    <% if (typeof mandatoryOdometerPrompt !== 'undefined' && mandatoryOdometerPrompt) { %>
      <% const mop = mandatoryOdometerPrompt; %>
      <dialog id="mandatoryOdometerDialog" class="tight-gap-dialog" data-autoshow data-no-cancel>
        <% if (mop.type === "start") { %>
          <h2 class="tight-gap-dialog__title">Before you go &mdash; Start Odometer</h2>
          <p class="tight-gap-dialog__body">
            Enter the starting odometer reading for the
            <%= mop.reservation.vehicleId.year ? mop.reservation.vehicleId.year + " " : "" %><%= mop.reservation.vehicleId.make %>
            <%= mop.reservation.vehicleId.model %> to continue.
          </p>
          <form class="auth-form" action="/reservations/<%= mop.reservation._id %>/mileage" method="POST">
            <div class="auth-form__group">
              <label class="auth-form__label" for="mandatoryStartMileage">Start odometer (mi)</label>
              <input
                class="auth-form__input"
                type="number"
                id="mandatoryStartMileage"
                name="startMileage"
                min="0"
                required
                autofocus
              />
            </div>
            <button class="auth-form__submit" type="submit">Save and continue</button>
          </form>
          <form action="/reservations/<%= mop.reservation._id %>/cancel" method="POST">
            <button class="tight-gap-dialog__cancel" type="submit">Cancel this booking instead</button>
          </form>
        <% } else { %>
          <h2 class="tight-gap-dialog__title">One more thing &mdash; End Odometer</h2>
          <p class="tight-gap-dialog__body">
            The <%= mop.reservation.vehicleId.make %> <%= mop.reservation.vehicleId.model %>
            was returned, but the ending odometer reading is still missing.
          </p>
          <form class="auth-form" action="/reservations/<%= mop.reservation._id %>/mileage" method="POST">
            <div class="auth-form__group">
              <label class="auth-form__label" for="mandatoryEndMileage">End odometer (mi)</label>
              <input
                class="auth-form__input"
                type="number"
                id="mandatoryEndMileage"
                name="endMileage"
                min="0"
                required
                autofocus
              />
            </div>
            <button class="auth-form__submit" type="submit">Save and continue</button>
          </form>
        <% } %>
        <form action="/logout" method="POST">
          <button class="tight-gap-dialog__cancel" type="submit">Log out</button>
        </form>
      </dialog>
    <% } %>
    <script src="<%= asset('/js/app.js') %>" defer></script>
  </body>
</html>
