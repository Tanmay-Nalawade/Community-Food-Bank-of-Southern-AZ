<% layout('layouts/boilerplate') %>

<%
  const v = values || {};
  const checked = (name) => (v[name] === "on" ? "checked" : "");
%>

<section class="auth-page">
  <div class="auth-card auth-card--wide">
    <h1 class="auth-card__title">Log a Trip</h1>
    <p class="auth-card__subtitle">
      Record a trip that happened without a booking. It's saved as a completed trip, so it shows up in
      the trip log, the vehicle's mileage log and emailed reports, and the vehicle's odometer is
      updated from it.
    </p>

    <form class="auth-form" action="/admin/trips" method="POST">
      <div class="auth-form__group">
        <label class="auth-form__label" for="vehicleId">Vehicle</label>
        <select class="auth-form__input" id="vehicleId" name="vehicleId" required>
          <option value="">Choose a vehicle…</option>
          <% vehicles.forEach((vehicle) => { %>
            <option value="<%= vehicle.id %>" <%= String(vehicle.id) === String(v.vehicleId) ? "selected" : "" %>>
              <%= vehicle.year ? vehicle.year + " " : "" %><%= vehicle.make %> <%= vehicle.model %>
              (<%= vehicle.licensePlate %>) — odometer <%= vehicle.currentMileage.toLocaleString() %> mi
            </option>
          <% }) %>
        </select>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label" for="userId">Driver</label>
        <select class="auth-form__input" id="userId" name="userId" required>
          <option value="">Who drove?</option>
          <% drivers.forEach((driver) => { %>
            <option value="<%= driver.id %>" <%= String(driver.id) === String(v.userId) ? "selected" : "" %>>
              <%= driver.firstName %> <%= driver.lastName %> (<%= driver.email %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div class="auth-form__row">
        <div class="auth-form__group">
          <label class="auth-form__label" for="date">Date</label>
          <input class="auth-form__input" type="date" id="date" name="date" max="<%= maxDate %>" value="<%= v.date || "" %>" required />
        </div>
        <div class="auth-form__group">
          <label class="auth-form__label" for="startTime">Start time</label>
          <input class="auth-form__input" type="time" id="startTime" name="startTime" value="<%= v.startTime || "" %>" required />
        </div>
        <div class="auth-form__group">
          <label class="auth-form__label" for="endTime">End time</label>
          <input class="auth-form__input" type="time" id="endTime" name="endTime" value="<%= v.endTime || "" %>" required />
        </div>
      </div>

      <div class="auth-form__row">
        <div class="auth-form__group">
          <label class="auth-form__label" for="endMileage">Ending odometer (mi)</label>
          <input class="auth-form__input" type="number" id="endMileage" name="endMileage" min="0" value="<%= v.endMileage ?? "" %>" required />
        </div>
        <div class="auth-form__group">
          <label class="auth-form__label" for="fuelLevelEndPercent">Fuel level at end (%)</label>
          <input class="auth-form__input" type="number" id="fuelLevelEndPercent" name="fuelLevelEndPercent" min="0" max="100" value="<%= v.fuelLevelEndPercent ?? "" %>" />
        </div>
      </div>
      <p class="vehicle-detail__empty">
        The start reading is filled in automatically: it's the vehicle's reading after its previous trip.
      </p>

      <div class="auth-form__group">
        <span class="auth-form__label">Was this trip food related?</span>
        <div class="auth-form__radio-row">
          <% ["Yes", "No", "Other"].forEach((option) => { %>
            <label class="auth-form__radio">
              <input type="radio" name="tripFoodRelated" value="<%= option %>" <%= v.tripFoodRelated === option ? "checked" : "" %> required /> <%= option %>
            </label>
          <% }) %>
        </div>
      </div>

      <div class="auth-form__group js-trip-food-other" <%= v.tripFoodRelated === "Other" ? "" : "hidden" %>>
        <label class="auth-form__label" for="tripFoodRelatedDetail">Please describe the purpose of this trip</label>
        <textarea class="auth-form__input booking-request-card__textarea" id="tripFoodRelatedDetail" name="tripFoodRelatedDetail" rows="2"><%= v.tripFoodRelatedDetail || "" %></textarea>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label"><input type="checkbox" name="droppedOffFood" <%= checked("droppedOffFood") %> /> Dropped off CFB food using this vehicle</label>
      </div>
      <div class="auth-form__group">
        <label class="auth-form__label"><input type="checkbox" name="pickedUpFood" <%= checked("pickedUpFood") %> /> Picked up CFB food using this vehicle</label>
      </div>
      <div class="auth-form__group">
        <label class="auth-form__label"><input type="checkbox" name="washed" <%= checked("washed") %> /> Vehicle was washed</label>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label" for="adminNotes">Note (optional)</label>
        <textarea
          class="auth-form__input booking-request-card__textarea"
          id="adminNotes"
          name="adminNotes"
          rows="2"
          placeholder="e.g. Taken for an emergency pickup without a reservation"
        ><%= v.adminNotes || "" %></textarea>
      </div>

      <button class="auth-form__submit" type="submit">Log trip</button>
    </form>
  </div>
</section>
