<% reservations.forEach((reservation) => { %>
  <tr>
    <td>
      <% if (reservation.vehicleId) { %>
        <a href="/admin/vehicles/<%= reservation.vehicleId._id %>">
          <%= reservation.vehicleId.year ? reservation.vehicleId.year + " " : "" %><%= reservation.vehicleId.make %> <%= reservation.vehicleId.model %>
        </a>
      <% } else { %>
        —
      <% } %>
    </td>
    <td>
      <%= new Date(reservation.requestedStartTime).toLocaleString() %>
      &ndash;
      <%= new Date(reservation.requestedEndTime).toLocaleString() %>
    </td>
    <td>
      <%- include('../../partials/status-pill', { value: reservation.status }) %>
    </td>
    <td>
      <% if (reservation.tripLog?.startMileage != null && reservation.tripLog?.endMileage != null) { %>
        <%= (reservation.tripLog.endMileage - reservation.tripLog.startMileage).toLocaleString() %> mi
      <% } else { %>
        —
      <% } %>
    </td>
    <td class="admin-table__actions">
      <a class="admin-table__btn admin-table__btn--edit" href="/admin/reservations/<%= reservation._id %>">View</a>
    </td>
  </tr>
<% }) %>
