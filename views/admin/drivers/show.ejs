<% layout('layouts/boilerplate') %>

<section class="admin-page">
  <a class="vehicle-detail__back" href="/admin/drivers">&larr; Back to drivers</a>

  <h1><%= driver.firstName %> <%= driver.lastName %></h1>
  <p class="vehicles-page__lead">
    <%= driver.email %> &middot; <%= driver.role %> &middot; <%= driver.isActive ? "Active" : "Inactive" %>
  </p>

  <div class="vehicle-detail__card admin-history-card">
    <h2 class="vehicle-detail__section-title">Reservation history</h2>
    <% if (!reservations.length) { %>
      <p class="vehicle-detail__empty">This driver has no reservations yet.</p>
    <% } else { %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Vehicle</th>
              <th>When</th>
              <th>Status</th>
              <th>Distance</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="driver-reservations-body">
            <%- include('_reservation-rows', { reservations }) %>
          </tbody>
        </table>
      </div>

      <% if (hasMore) { %>
        <button
          class="admin-table__btn admin-table__btn--edit load-more-btn"
          type="button"
          data-load-more
          data-url="/admin/drivers/<%= driver._id %>/reservations/more"
          data-target="driver-reservations-body"
          data-page-size="<%= pageSize %>"
          data-skip="<%= nextSkip %>"
        >
          Load more
        </button>
      <% } %>
    <% } %>
  </div>
</section>
