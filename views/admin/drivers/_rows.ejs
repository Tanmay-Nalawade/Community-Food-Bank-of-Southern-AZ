<% drivers.forEach((driver) => { %>
  <tr>
    <td data-label="Name"><%= driver.firstName %> <%= driver.lastName %></td>
    <td data-label="Email"><%= driver.email %></td>
    <td data-label="Role">
      <%- include('../../partials/status-pill', { value: driver.role }) %>
    </td>
    <td data-label="Status">
      <%- include('../../partials/status-pill', {
        slug: driver.isActive ? 'active-account' : 'inactive-account',
        label: driver.isActive ? 'Active' : 'Inactive',
      }) %>
    </td>
    <td class="admin-table__actions" data-label="Actions">
      <a class="admin-table__btn admin-table__btn--edit" href="/admin/drivers/<%= driver.id %>">View</a>
    </td>
  </tr>
<% }) %>
