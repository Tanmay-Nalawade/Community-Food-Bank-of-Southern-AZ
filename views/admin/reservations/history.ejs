<% layout('layouts/boilerplate') %>

<section class="admin-page">
  <div class="vehicles-page__header">
    <div>
      <h1>Booking History</h1>
      <p class="vehicles-page__lead">
        Every booking whose window has already ended, newest first. Click a row's View link for
        full details, including trip mileage.
      </p>
    </div>
    <a class="vehicles-page__add-btn" href="/admin/reservations">All Reservations</a>
  </div>

  <% if (!reservations.length) { %>
    <p class="vehicles-page__empty">No past bookings yet.</p>
  <% } else { %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Staff</th>
            <th>Vehicle</th>
            <th>When</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="history-body">
          <%- include('_history-rows', { reservations }) %>
        </tbody>
      </table>
    </div>

    <% if (hasMore) { %>
      <button
        class="admin-table__btn admin-table__btn--edit load-more-btn"
        type="button"
        data-load-more
        data-url="/admin/reservations/history/more"
        data-target="history-body"
        data-page-size="<%= pageSize %>"
        data-skip="<%= nextSkip %>"
      >
        Load more
      </button>
    <% } %>
  <% } %>
</section>
