<% reservations.forEach((reservation) => { %>
  <tr class="<%= reservation.status === 'Pending' ? 'admin-table__row--attention' : '' %>">
    <%- include('_row-cells', { reservation }) %>
    <td class="admin-table__actions" data-label="Actions">
      <div class="action-bar action-bar--row">
        <% if (["Pending", "Reserved", "Active"].includes(reservation.status)) { %>
          <div class="action-group">
            <% if (reservation.status === "Pending") { %>
              <form action="/admin/reservations/<%= reservation._id %>/approve" method="POST">
                <button class="action-btn action-btn--sm action-btn--approve" type="submit">Approve</button>
              </form>
              <form action="/admin/reservations/<%= reservation._id %>/deny" method="POST">
                <button class="action-btn action-btn--sm action-btn--deny" type="submit">Deny</button>
              </form>
            <% } %>
            <% if (["Reserved", "Active"].includes(reservation.status)) { %>
              <form action="/admin/reservations/<%= reservation._id %>/cancel" method="POST">
                <button class="action-btn action-btn--sm action-btn--deny" type="submit">Cancel</button>
              </form>
            <% } %>
          </div>
        <% } %>
        <%# Edit and Delete live on the booking's own page, one click away via View. %>
        <a class="action-btn action-btn--sm action-btn--edit" href="/admin/reservations/<%= reservation._id %>">View</a>
      </div>
    </td>
  </tr>
<% }) %>
