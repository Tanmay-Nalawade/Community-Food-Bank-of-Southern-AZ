<% layout('layouts/boilerplate') %>

<section class="admin-page mileage-log-page">
  <a class="vehicle-detail__back no-print" href="/admin/vehicles/<%= vehicle.id %>">&larr; Back to vehicle</a>

  <div class="mileage-log-page__header-row">
    <h1>Monthly Vehicle Mileage Log Sheet</h1>
    <button class="action-btn action-btn--edit no-print" type="button" data-print>
      Print
    </button>
  </div>

  <div class="vehicle-detail__card admin-history-card mileage-log-card">
    <%- include('_sheet-header', { vehicle, monthLabel: log.monthLabel }) %>

    <div class="mileage-log-page__month-nav no-print">
      <a class="admin-table__btn admin-table__btn--edit" href="?year=<%= prev.year %>&month=<%= prev.month %>">
        &larr; Previous month
      </a>
      <a class="admin-table__btn admin-table__btn--edit" href="?year=<%= next.year %>&month=<%= next.month %>">
        Next month &rarr;
      </a>
    </div>

    <% if (log.isEmpty) { %>
      <p class="vehicle-detail__empty">No trips recorded for this vehicle in <%= log.monthLabel %>.</p>
    <% } else { %>
      <%- include('_table', { rows: log.rows }) %>
    <% } %>
  </div>
</section>
