<% layout('layouts/boilerplate') %>

<section class="admin-page">
  <h1>Vehicle Issues</h1>
  <p class="vehicles-page__lead admin-page__lead">
    Problems drivers report after a trip or flag during a vehicle inspection. New ones are
    listed first.
  </p>

  <% if (!issues.length) { %>
    <div class="admin-empty">
      <h2 class="admin-empty__title">No open issues</h2>
      <p>When a driver reports a problem with a vehicle, it shows up here for you to review.</p>
    </div>
  <% } else { %>
    <div class="admin-table-wrap">
      <table class="admin-table admin-table--detailed">
        <thead>
          <tr>
            <th>Issue</th>
            <th>Vehicle</th>
            <th>Reported</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="issues-body">
          <%- include('_rows', { issues }) %>
        </tbody>
      </table>
    </div>

    <% if (hasMore) { %>
      <button
        class="admin-table__btn admin-table__btn--edit load-more-btn"
        type="button"
        data-load-more
        data-url="/admin/issues/more"
        data-target="issues-body"
        data-page-size="<%= pageSize %>"
        data-skip="<%= nextSkip %>"
      >
        Load more
      </button>
    <% } %>
  <% } %>
</section>
