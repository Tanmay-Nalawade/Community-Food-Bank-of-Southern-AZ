<% layout('layouts/boilerplate') %>

<section class="admin-page">
  <h1>Vehicle Issues</h1>
  <p class="vehicles-page__lead">Issues reported by drivers, newest unreviewed first.</p>

  <% if (!issues.length) { %>
    <p class="vehicles-page__empty">No issues reported.</p>
  <% } else { %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Status</th>
            <th>Vehicle</th>
            <th>Issue</th>
            <th>Reported by</th>
            <th>Reported</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="issues-body">
          <%- include('_rows', { issues }) %>
        </tbody>
      </table>
    </div>

    <% if (hasMore) { %>
      <button
        class="admin-table__btn admin-table__btn--edit load-more-btn"
        type="button"
        data-load-more
        data-url="/admin/issues/more"
        data-target="issues-body"
        data-page-size="<%= pageSize %>"
        data-skip="<%= nextSkip %>"
      >
        Load more
      </button>
    <% } %>
  <% } %>
</section>
