<% layout('layouts/boilerplate') %>

<section class="admin-page">
  <h1>Reports</h1>
  <p class="vehicles-page__lead">Trip log, fleet utilization, and KeyCafe access history.</p>

  <div class="vehicle-detail__card admin-history-card">
    <h2 class="vehicle-detail__section-title">Trip log</h2>
    <p class="vehicle-detail__empty admin-hint">
      Every trip across the fleet, newest first. Click a vehicle to see that trip's full
      detailed monthly mileage log (inspection, fuel level, and more).
    </p>
    <% if (!tripLog.length) { %>
      <p class="vehicle-detail__empty">No trips recorded yet.</p>
    <% } else { %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Vehicle</th>
              <th>Driver</th>
              <th>Start Odometer</th>
              <th>End Odometer</th>
              <th>Distance Travelled</th>
              <th>Food Related</th>
            </tr>
          </thead>
          <tbody id="trip-log-body">
            <%- include('_trip-log-rows', { tripLog }) %>
          </tbody>
        </table>
      </div>

      <% if (tripHasMore) { %>
        <button
          class="admin-table__btn admin-table__btn--edit load-more-btn"
          type="button"
          data-load-more
          data-url="/admin/reports/trips/more"
          data-target="trip-log-body"
          data-page-size="<%= pageSize %>"
          data-skip="<%= tripNextSkip %>"
        >
          Load more
        </button>
      <% } %>
    <% } %>
  </div>

  <div class="vehicle-detail__card admin-history-card">
    <h2 class="vehicle-detail__section-title">Vehicle utilization</h2>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Vehicle</th>
            <th>Current mileage</th>
            <th>Bookings</th>
            <th>Total hours booked</th>
            <th>Last booked</th>
            <th>Idle 30+ days</th>
          </tr>
        </thead>
        <tbody>
          <% vehicleReport.forEach((row) => { %>
            <tr>
              <td data-label="Vehicle">
                <a href="/admin/vehicles/<%= row.vehicle.id %>">
                  <%= row.vehicle.year ? row.vehicle.year + " " : "" %><%= row.vehicle.make %> <%= row.vehicle.model %>
                </a>
                <br />
                <span class="admin-table__subtext"><%= row.vehicle.licensePlate %></span>
              </td>
              <td data-label="Current mileage"><%= row.vehicle.currentMileage.toLocaleString() %> mi</td>
              <td data-label="Bookings"><%= row.bookingCount %></td>
              <td data-label="Total hours booked"><%= row.totalHours %></td>
              <td data-label="Last booked"><%= row.lastBookedAt ? fmt.date(row.lastBookedAt) : "Never" %></td>
              <td data-label="Idle 30+ days">
                <% if (row.idle) { %>
                  <%- include('../../partials/status-pill', { slug: 'maintenance', label: 'Idle' }) %>
                <% } else { %>
                  —
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="vehicle-detail__card admin-history-card">
    <h2 class="vehicle-detail__section-title">KeyCafe access log</h2>
    <p class="vehicle-detail__empty admin-hint">Grants, revokes, pickups, and drop-offs, newest first.</p>
    <% if (!accessLogs.length) { %>
      <p class="vehicle-detail__empty">No access events recorded yet.</p>
    <% } else { %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>When</th>
              <th>Action</th>
              <th>Driver</th>
              <th>Vehicle</th>
              <th>Booking code</th>
            </tr>
          </thead>
          <tbody id="access-log-body">
            <%- include('_access-log-rows', { accessLogs }) %>
          </tbody>
        </table>
      </div>

      <% if (hasMore) { %>
        <button
          class="admin-table__btn admin-table__btn--edit load-more-btn"
          type="button"
          data-load-more
          data-url="/admin/reports/more"
          data-target="access-log-body"
          data-page-size="<%= pageSize %>"
          data-skip="<%= nextSkip %>"
        >
          Load more
        </button>
      <% } %>
    <% } %>
  </div>
</section>
