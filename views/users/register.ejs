<% layout('layouts/boilerplate') %>

<section class="auth-page auth-page--split">
  <aside class="auth-panel">
    <p class="auth-panel__eyebrow">Motor Pool &middot; New Account</p>
    <h2 class="auth-panel__heading">One account gets you on the road.</h2>
    <p class="auth-panel__copy">
      Create your account to start booking shared vehicles for deliveries,
      pickups, and errands across the Food Bank, and to pick up keys from
      the KeyCafe box on-site.
    </p>
  </aside>

  <div class="auth-page__content">
  <div class="auth-card">
    <h1 class="auth-card__title">Sign Up</h1>
    <p class="auth-card__subtitle">Create an account to access the motor pool.</p>

    <form class="auth-form" action="/register" method="POST">
      <div class="auth-form__row">
        <div class="auth-form__group">
          <label class="auth-form__label" for="firstName">First name</label>
          <input
            class="auth-form__input"
            type="text"
            id="firstName"
            name="firstName"
            autocomplete="given-name"
            required
          />
        </div>
        <div class="auth-form__group">
          <label class="auth-form__label" for="lastName">Last name</label>
          <input
            class="auth-form__input"
            type="text"
            id="lastName"
            name="lastName"
            autocomplete="family-name"
            required
          />
        </div>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label" for="email">Email</label>
        <input
          class="auth-form__input"
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
        />
      </div>

      <div class="auth-form__group">
        <div class="auth-form__label-row">
          <label class="auth-form__label" for="password">Password</label>
          <button type="button" class="auth-form__toggle-password" data-target="password">Show</button>
        </div>
        <input
          class="auth-form__input"
          type="password"
          id="password"
          name="password"
          autocomplete="new-password"
          required
        />
      </div>

      <div class="auth-form__group">
        <div class="auth-form__label-row">
          <label class="auth-form__label" for="confirmPassword">Confirm password</label>
          <button type="button" class="auth-form__toggle-password" data-target="confirmPassword">Show</button>
        </div>
        <input
          class="auth-form__input"
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          autocomplete="new-password"
          required
        />
      </div>

      <button class="auth-form__submit" type="submit">Create Account</button>
    </form>

    <p class="auth-card__footer">
      Already have an account?
      <a href="/login">Log in</a>
    </p>
  </div>
  </div>
</section>
