<% layout('layouts/boilerplate') %>

<section class="auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">Reset Password</h1>

    <% if (invalid) { %>
      <p class="auth-card__subtitle">
        This reset link is invalid or has expired.
      </p>
      <p class="auth-card__footer">
        <a href="/forgot-password">Request a new link</a>
      </p>
    <% } else { %>
      <p class="auth-card__subtitle">Choose a new password for your account.</p>

      <form class="auth-form" action="/reset-password/<%= token %>" method="POST">
        <div class="auth-form__group">
          <div class="auth-form__label-row">
            <label class="auth-form__label" for="password">New password</label>
            <button type="button" class="auth-form__toggle-password" data-target="password">Show</button>
          </div>
          <input
            class="auth-form__input"
            type="password"
            id="password"
            name="password"
            autocomplete="new-password"
            required
          />
        </div>

        <div class="auth-form__group">
          <div class="auth-form__label-row">
            <label class="auth-form__label" for="confirmPassword">Confirm new password</label>
            <button type="button" class="auth-form__toggle-password" data-target="confirmPassword">Show</button>
          </div>
          <input
            class="auth-form__input"
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            autocomplete="new-password"
            required
          />
        </div>

        <button class="auth-form__submit" type="submit">Reset Password</button>
      </form>
    <% } %>
  </div>
</section>
