<% layout('layouts/boilerplate') %>

<section class="auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">Forgot Password</h1>
    <p class="auth-card__subtitle">Enter your email and we'll send you a link to reset your password.</p>

    <form class="auth-form" action="/forgot-password" method="POST">
      <div class="auth-form__group">
        <label class="auth-form__label" for="email">Email</label>
        <input
          class="auth-form__input"
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
        />
      </div>

      <button class="auth-form__submit" type="submit">Send Reset Link</button>
    </form>

    <p class="auth-card__footer">
      <a href="/login">Back to log in</a>
    </p>
  </div>
</section>
