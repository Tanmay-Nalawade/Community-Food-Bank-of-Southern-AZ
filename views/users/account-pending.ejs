<% layout('layouts/boilerplate') %>

<section class="auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">Account Pending Approval</h1>

    <p class="auth-card__subtitle">
      Thank you for signing up for the Community Food Bank Motor Pool. Your account is awaiting approval
      from an administrator. You'll receive an email as soon as it has been approved, and you can log in then.
    </p>

    <p class="auth-card__footer">
      <a href="/login">Back to log in</a>
    </p>
  </div>
</section>
