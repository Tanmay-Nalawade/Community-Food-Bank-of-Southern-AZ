<% layout('layouts/boilerplate') %>

<section class="reservations-page">
  <a class="vehicle-detail__back" href="/reservations/mine">&larr; Back to my dashboard</a>

  <h1>Report Mileage</h1>
  <p class="reservations-page__lead">
    <%= reservation.vehicle.year ? reservation.vehicle.year + " " : "" %>
    <%= reservation.vehicle.make %> <%= reservation.vehicle.model %>
    (<%= reservation.vehicle.licensePlate %>)
  </p>

  <div class="auth-card auth-card--wide admin-edit-card">
    <form class="auth-form" action="/reservations/<%= reservation.id %>/mileage" method="POST">
      <div class="auth-form__row">
        <div class="auth-form__group">
          <label class="auth-form__label" for="startReading">Start mileage</label>
          <input
            class="auth-form__input"
            type="text"
            id="startReading"
            value="<%= startReading != null ? startReading.toLocaleString() : '—' %>"
            readonly
            disabled
          />
        </div>
        <div class="auth-form__group">
          <label class="auth-form__label" for="endMileage">End mileage</label>
          <input
            class="auth-form__input"
            type="number"
            id="endMileage"
            name="endMileage"
            min="<%= startReading ?? 0 %>"
            value="<%= reservation.endMileage ?? '' %>"
          />
        </div>
      </div>

      <p class="vehicle-detail__empty">
        The start reading is filled in automatically from the vehicle's odometer (the previous
        trip's end reading). Enter the end reading when you're done — you can come back and
        fill it in later.
      </p>

      <div class="auth-form__row">
        <div class="auth-form__group">
          <label class="auth-form__label" for="fuelLevelEndPercent">Fuel level at end (%)</label>
          <input
            class="auth-form__input"
            type="number"
            id="fuelLevelEndPercent"
            name="fuelLevelEndPercent"
            min="0"
            max="100"
            value="<%= reservation.fuelLevelEndPercent ?? '' %>"
          />
        </div>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label">
          <input
            type="checkbox"
            name="preTripInspectionPassed"
            <%= reservation.preTripInspectionPassed ? "checked" : "" %>
          />
          Pre-trip inspection passed
        </label>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label">
          <input
            type="checkbox"
            name="droppedOffFood"
            <%= reservation.droppedOffFood ? "checked" : "" %>
          />
          Dropped off CFB food using this vehicle
        </label>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label">
          <input
            type="checkbox"
            name="pickedUpFood"
            <%= reservation.pickedUpFood ? "checked" : "" %>
          />
          Picked up CFB food using this vehicle
        </label>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label">
          <input
            type="checkbox"
            name="otherDuty"
            <%= reservation.otherDuty ? "checked" : "" %>
          />
          Used for other CFB business
        </label>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label" for="otherDutyNote">If "other," briefly describe</label>
        <textarea
          class="auth-form__input"
          id="otherDutyNote"
          name="otherDutyNote"
          rows="2"
        ><%= reservation.otherDutyNote || "" %></textarea>
      </div>

      <div class="auth-form__group">
        <label class="auth-form__label">
          <input type="checkbox" name="washed" <%= reservation.washed ? "checked" : "" %> />
          Vehicle washed
        </label>
      </div>

      <button class="auth-form__submit" type="submit">Save Mileage</button>
    </form>
  </div>
</section>
