<% layout('layouts/boilerplate') %>

<section class="reservations-page">
  <h1>My Dashboard</h1>
  <p class="reservations-page__lead">View your current and upcoming vehicle bookings.</p>

  <section class="dashboard-section">
    <h2 class="dashboard-section__title">Current Bookings</h2>

    <% if (!currentBookings.length) { %>
      <p class="vehicles-page__empty">You don't have any current bookings.</p>
    <% } else { %>
      <%- include('../partials/booking-table', { reservations: currentBookings }) %>
    <% } %>
  </section>

  <section class="dashboard-section">
    <h2 class="dashboard-section__title">Upcoming Bookings</h2>

    <% if (!upcomingBookings.length) { %>
      <p class="vehicles-page__empty">
        You don't have any upcoming bookings. <a href="/">Make a booking</a> if you want.
      </p>
    <% } else { %>
      <%- include('../partials/booking-table', { reservations: upcomingBookings }) %>
    <% } %>
  </section>
</section>
