<% layout('layouts/boilerplate') %>

<section class="reservations-page">
  <h1>My Dashboard</h1>
  <p class="reservations-page__lead">Your current, upcoming, and past vehicle bookings.</p>

  <section class="dashboard-section">
    <div class="dashboard-section__header">
      <h2 class="dashboard-section__title">Current Bookings</h2>
      <% if (currentBookings.length) { %>
        <span class="dashboard-section__count"><%= currentBookings.length %></span>
      <% } %>
    </div>

    <% if (!currentBookings.length) { %>
      <div class="dashboard-empty">
        <p>No vehicle checked out right now. <a href="/">Book a vehicle</a> when you're ready to head out.</p>
      </div>
    <% } else { %>
      <%- include('../partials/booking-list', { reservations: currentBookings }) %>
    <% } %>
  </section>

  <section class="dashboard-section">
    <div class="dashboard-section__header">
      <h2 class="dashboard-section__title">Upcoming Bookings</h2>
      <% if (upcomingBookings.length) { %>
        <span class="dashboard-section__count"><%= upcomingBookings.length %></span>
      <% } %>
    </div>

    <% if (!upcomingBookings.length) { %>
      <div class="dashboard-empty">
        <p>Nothing on the calendar yet. <a href="/">Make a booking</a> if you want.</p>
      </div>
    <% } else { %>
      <%- include('../partials/booking-list', { reservations: upcomingBookings }) %>
    <% } %>
  </section>

  <section class="dashboard-section">
    <div class="dashboard-section__header">
      <h2 class="dashboard-section__title">Past Bookings</h2>
      <% if (pastBookings.length) { %>
        <span class="dashboard-section__count"><%= pastBookings.length %></span>
      <% } %>
    </div>

    <% if (!pastBookings.length) { %>
      <div class="dashboard-empty">
        <p>You don't have any past bookings yet.</p>
      </div>
    <% } else { %>
      <%- include('../partials/booking-list', { reservations: pastBookings, muted: true, id: 'past-bookings-list' }) %>

      <% if (pastHasMore) { %>
        <button
          class="admin-table__btn admin-table__btn--edit load-more-btn"
          type="button"
          data-load-more
          data-url="/reservations/mine/past/more"
          data-target="past-bookings-list"
          data-page-size="<%= pageSize %>"
          data-skip="<%= pastNextSkip %>"
        >
          Load more
        </button>
      <% } %>
    <% } %>
  </section>
</section>
