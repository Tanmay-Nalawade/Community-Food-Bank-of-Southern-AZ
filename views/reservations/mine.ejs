<% layout('layouts/boilerplate') %>

<%
  // The booking that matters most right now gets the hero: the vehicle you
  // have out, otherwise your next trip. It's left out of the lists below so
  // it isn't shown twice.
  const featured = currentBookings[0] || upcomingBookings[0] || null;
  const isOut = Boolean(featured && currentBookings[0] === featured);
  const otherCurrent = currentBookings.filter((r) => r !== featured);
  const otherUpcoming = upcomingBookings.filter((r) => r !== featured);
%>

<section class="reservations-page staff-dashboard">
  <div class="staff-dashboard__hero">
    <div class="staff-dashboard__hero-top">
      <div>
        <h1 class="staff-dashboard__greeting">Hi, <%= currentUser.firstName %></h1>
        <p class="staff-dashboard__hero-label">
          <% if (!featured) { %>
            You don&rsquo;t have any trips booked.
          <% } else if (isOut) { %>
            You have a vehicle checked out.
          <% } else { %>
            Your next trip
          <% } %>
        </p>
      </div>
      <a class="staff-dashboard__book" href="/">Book a vehicle</a>
    </div>

    <% if (featured) { %>
      <%- include('../partials/booking-list', { reservations: [featured], featured: true }) %>
    <% } else { %>
      <p class="staff-dashboard__hero-empty">
        Pick a date and time and we&rsquo;ll show you which vehicles are free.
      </p>
    <% } %>
  </div>

  <% if (otherCurrent.length) { %>
    <section class="dashboard-section">
      <div class="dashboard-section__header">
        <h2 class="dashboard-section__title">Also checked out</h2>
        <span class="dashboard-section__count"><%= otherCurrent.length %></span>
      </div>
      <%- include('../partials/booking-list', { reservations: otherCurrent }) %>
    </section>
  <% } %>

  <section class="dashboard-section">
    <div class="dashboard-section__header">
      <h2 class="dashboard-section__title"><%= isOut || !featured ? "Upcoming trips" : "Later trips" %></h2>
      <% if (otherUpcoming.length) { %>
        <span class="dashboard-section__count"><%= otherUpcoming.length %></span>
      <% } %>
    </div>

    <% if (!otherUpcoming.length) { %>
      <p class="dashboard-empty"><%= featured ? "No other trips on the calendar." : "Nothing on the calendar yet." %></p>
    <% } else { %>
      <%- include('../partials/booking-list', { reservations: otherUpcoming }) %>
    <% } %>
  </section>

  <section class="dashboard-section">
    <div class="dashboard-section__header">
      <h2 class="dashboard-section__title">Past trips</h2>
      <a class="dashboard-section__link" href="/reservations/history">Booking history</a>
    </div>

    <% if (!pastBookings.length) { %>
      <p class="dashboard-empty">Trips you finish will show up here.</p>
    <% } else { %>
      <%- include('../partials/booking-list', { reservations: pastBookings, muted: true, id: 'past-bookings-list' }) %>

      <% if (pastHasMore) { %>
        <button
          class="admin-table__btn admin-table__btn--edit load-more-btn"
          type="button"
          data-load-more
          data-url="/reservations/mine/past/more"
          data-target="past-bookings-list"
          data-page-size="<%= pageSize %>"
          data-skip="<%= pastNextSkip %>"
        >
          Load more
        </button>
      <% } %>
    <% } %>
  </section>
</section>
