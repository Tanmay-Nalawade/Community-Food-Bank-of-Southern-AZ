<% logs.forEach((log) => { %>
  <tr>
    <td data-label="When"><%= fmt.dateTime(log.createdAt) %></td>
    <td data-label="User">
      <% if (log.user) { %>
        <%= log.user.firstName %> <%= log.user.lastName %>
        <br />
        <span class="admin-table__subtext"><%= log.user.email %></span>
      <% } else { %>
        —
      <% } %>
    </td>
    <td data-label="Action"><%= log.action %></td>
    <td data-label="Detail"><%= log.detail || "—" %></td>
  </tr>
<% }) %>
