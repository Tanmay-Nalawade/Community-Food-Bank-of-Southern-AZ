<% logs.forEach((log) => { %>
  <tr>
    <td data-label="When"><%= new Date(log.createdAt).toLocaleString() %></td>
    <td data-label="User">
      <% if (log.userId) { %>
        <%= log.userId.firstName %> <%= log.userId.lastName %>
        <br />
        <span class="admin-table__subtext"><%= log.userId.email %></span>
      <% } else { %>
        —
      <% } %>
    </td>
    <td data-label="Action"><%= log.action %></td>
    <td data-label="Detail"><%= log.detail || "—" %></td>
  </tr>
<% }) %>
