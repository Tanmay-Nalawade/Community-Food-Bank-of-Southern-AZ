<% layout('layouts/boilerplate') %>

<section class="admin-page">
  <h1>Activity Log</h1>
  <p class="vehicles-page__lead">Most recent 200 login, logout, and role-switch events.</p>

  <% if (!logs.length) { %>
    <p class="vehicles-page__empty">No activity recorded yet.</p>
  <% } else { %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>When</th>
            <th>User</th>
            <th>Action</th>
            <th>Detail</th>
          </tr>
        </thead>
        <tbody id="activity-log-body">
          <%- include('_rows', { logs }) %>
        </tbody>
      </table>
    </div>

    <% if (hasMore) { %>
      <button
        class="admin-table__btn admin-table__btn--edit load-more-btn"
        type="button"
        data-load-more
        data-url="/it/activity/more"
        data-target="activity-log-body"
        data-page-size="<%= pageSize %>"
        data-skip="<%= nextSkip %>"
      >
        Load more
      </button>
    <% } %>
  <% } %>
</section>
