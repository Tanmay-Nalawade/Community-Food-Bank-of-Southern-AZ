<header class="site-navbar" role="banner">
  <div class="site-navbar__inner">
    <a class="site-navbar__brand" href="/" aria-label="Community Food Bank of Southern Arizona — Home">
      <img
        class="site-navbar__logo"
        src="/images/Logo.png"
        alt="Community Food Bank of Southern Arizona — Celebrating 50 Years of Impact"
      />
    </a>

    <nav class="site-navbar__nav" aria-label="Main navigation">
      <a
        class="site-navbar__link<%= locals.activeNav === 'vehicles' ? ' site-navbar__link--active' : '' %>"
        href="/"
      >
        Book a Vehicle
      </a>

      <% if (currentUser) { %>
        <a
          class="site-navbar__link<%= locals.activeNav === 'dashboard' ? ' site-navbar__link--active' : '' %>"
          href="/reservations/mine"
        >
          Dashboard
        </a>
      <% } %>

      <details class="site-navbar__account">
        <summary class="site-navbar__btn site-navbar__account-toggle">
          My Account
        </summary>
        <div class="site-navbar__dropdown">
          <% if (!currentUser) { %>
            <a class="site-navbar__dropdown-link" href="/login">Log In</a>
            <a class="site-navbar__dropdown-link" href="/register">Sign Up</a>
          <% } else { %>
            <p class="site-navbar__dropdown-user">
              <%= currentUser.firstName %> <%= currentUser.lastName %>
              <span><%= currentUser.role %></span>
            </p>

            <% if (currentUser.role === "Admin") { %>
              <a class="site-navbar__dropdown-link" href="/admin/reservations">Admin Dashboard</a>
              <a class="site-navbar__dropdown-link" href="/admin/vehicles/add">Add Vehicle</a>
            <% } %>

            <form class="site-navbar__logout-form" action="/logout" method="POST">
              <button class="site-navbar__dropdown-link site-navbar__dropdown-link--button" type="submit">
                Log Out
              </button>
            </form>
          <% } %>
        </div>
      </details>
    </nav>
  </div>
</header>
