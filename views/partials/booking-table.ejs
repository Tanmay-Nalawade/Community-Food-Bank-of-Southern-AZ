<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Vehicle</th>
        <th>When</th>
        <th>Status</th>
        <th>Key Access</th>
        <th>Notes</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% reservations.forEach((reservation) => { %>
        <tr>
          <td>
            <%= reservation.vehicleId.year ? reservation.vehicleId.year + " " : "" %>
            <%= reservation.vehicleId.make %> <%= reservation.vehicleId.model %>
          </td>
          <td>
            <%= new Date(reservation.requestedStartTime).toLocaleString() %>
            &ndash;
            <%= new Date(reservation.requestedEndTime).toLocaleString() %>
          </td>
          <td>
            <span class="status-pill status-pill--<%= reservation.status.toLowerCase() %>">
              <%= reservation.status %>
            </span>
          </td>
          <td>
            <% if (reservation.keyCafeAccess?.bookingCode && ["Reserved", "Active"].includes(reservation.status)) { %>
              <strong class="booking-code"><%= reservation.keyCafeAccess.bookingCode %></strong>
              <div class="booking-code__window">
                Valid <%= new Date(reservation.requestedStartTime).toLocaleString() %>
                &ndash;
                <%= new Date(reservation.requestedEndTime).toLocaleString() %>
              </div>
              <div class="booking-code__hint">Use this same code to pick up and return the key.</div>
              <% if (reservation.keyCafeAccess.checkinLink) { %>
                <a href="<%= reservation.keyCafeAccess.checkinLink %>" target="_blank" rel="noopener noreferrer">
                  Open check-in link
                </a>
              <% } %>
            <% } else if (reservation.status === "Pending") { %>
              <span class="booking-code booking-code--pending">Pending review</span>
            <% } else { %>
              —
            <% } %>
          </td>
          <td><%= reservation.staffNotes || "—" %></td>
          <td class="admin-table__actions">
            <% if (reservation.status === "Pending") { %>
              <a class="admin-table__btn admin-table__btn--edit" href="/reservations/<%= reservation._id %>/edit">Edit</a>
            <% } %>
            <% if (["Pending", "Reserved"].includes(reservation.status)) { %>
              <form action="/reservations/<%= reservation._id %>/cancel" method="POST">
                <button class="admin-table__btn admin-table__btn--delete" type="submit">Cancel</button>
              </form>
            <% } %>
            <% if (["Active", "Completed"].includes(reservation.status)) { %>
              <a class="admin-table__btn admin-table__btn--edit" href="/reservations/<%= reservation._id %>/mileage">Report Mileage</a>
              <a class="admin-table__btn admin-table__btn--edit" href="/reservations/<%= reservation._id %>/issue">Report Issue</a>
            <% } %>
            <% if (!["Pending", "Reserved", "Active", "Completed"].includes(reservation.status)) { %>
              —
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
